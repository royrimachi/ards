# Local configuration (contains the database password).
.env

# macOS metadata.
.DS_Store

# Optional local Docker/Compose overrides and data dumps.
compose.override.yaml
*.dump
*.sql.gz

# PostgreSQL data directory (created at runtime; initdb needs it empty).
/data/postgres/

# Local backups.
/backups/

# JetBrains / DataGrip: share connection definitions, not local state.
.idea/*
!.idea/dataSources.xml

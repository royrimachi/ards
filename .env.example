# .env.example
# Copy to .env and adjust if needed:
#   cp .env.example .env
#
# These values are shared by every lab and script in the project.

# PostgreSQL superuser used by the local lab environment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword

# Maintenance database. Lab scripts never use it as their working database.
POSTGRES_DB=postgres

# Host port mapped to the container (bound to 127.0.0.1).
POSTGRES_PORT=5432

# Databases created automatically the first time the data directory is initialized.
# Add future lab databases here (comma-separated).
POSTGRES_DATABASES=optimization_db

# Host directory that stores the PostgreSQL cluster (relative to the repo root).
POSTGRES_DATA_DIR=./data/postgres
